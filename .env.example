# Apify API Token — get yours at https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_token_here

# Google Gemini API Key — get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Turso (SQLite in the cloud) — get yours at https://turso.tech
TURSO_CONNECTION_URL=libsql://your-db-name-xxx.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
# Cloudflare Pages Function - owner/client email routing
SITE_URL=https://example-website-landscaping.pages.dev
OWNER_EMAIL=owner@example.com

# Optional. Absolute https URL for the logo in owner/client emails.
# Default comes from site-config.js emailLogoUrl (email-assets/logo-email.png on raw.githubusercontent.com).
EMAIL_LOGO_URL=

# Cloudflare Turnstile server-side verification (store as an encrypted secret).
# The matching public site key is configured in site-config.js.
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Resend
RESEND_API_KEY=re_your_resend_api_key
# Use your verified sender/domain on Resend.
# Temporary testing option only: Brand Name <onboarding@resend.dev>
# Recommended production sender: Brand Name <quotes@yourdomain.com>
RESEND_FROM_EMAIL=Mesa Wren Landscape Co. <quotes@example.com>

# Optional sender display name. Defaults to site-config.js shortName.
FROM_NAME=
# Compatibility alias for RESEND_FROM_EMAIL
FROM_EMAIL=Mesa Wren Landscape Co. <quotes@example.com>

# Required for atomic production lead capture and exact-ticket idempotency.
# The live intake path uses this locked Apps Script webhook.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-web-app-id/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=your_shared_secret
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your-sheet-id/edit

# Optional Google Places live reviews
GOOGLE_PLACES_API_KEY=your_google_places_api_key
GOOGLE_PLACES_PLACE_ID=your_google_place_id
GOOGLE_PLACES_QUERY=Mesa Wren Landscape Co., Scottsdale, AZ 85260
GOOGLE_PLACES_PROFILE_URL=/reviews

# Frontend analytics
# Add GA4 Measurement ID (G-XXXXXXXXXX) in site-config.js under analytics.ga4MeasurementId
